# ===== ANC Dashboard — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env) =====
# ---- ฐานข้อมูล HOSxP (ผู้ใช้อ่านอย่างเดียว) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
PORT=6300
# direct = ต่อ DB ตรง (production) · ssh = ยิงผ่าน `ssh <host> mariadb` (dev ไม่มีรหัส DB)
ANC_DB_MODE=
ANC_SSH_HOST=
ANC_DB_TIMEOUT=60

# ---- รหัสที่แต่ละ รพ. อาจต่างกัน — ตรวจที่หน้า /check ----
# รหัสส่งออกวัคซีน dT หญิงตั้งครรภ์ (person_vaccine.export_vaccine_code / EPI.VACCINETYPE 201–205)
ANC_DT_VACCINE_CODES=201,202,203,204,205
# anc_lab_id ของผล Hct (ว่าง = หาจากชื่อใน anc_lab ที่มีคำว่า hct)
ANC_HCT_LAB_IDS=
# โลหิตจาง: Hct < ค่านี้ (%) ที่อายุครรภ์ >= ANC_HCT_LATE_GA สัปดาห์
ANC_HCT_CUTOFF=33
ANC_HCT_LATE_GA=28
# ทารกน้ำหนักน้อย: < กรัม
ANC_LBW_GRAMS=2500
# infant_dchstts ที่หมายถึงทารกเสียชีวิต/ตายคลอด (ตัดออกจากตัวหาร LBW)
ANC_DEAD_DCHSTTS=08,09
# นับ refer ถึงหลังคลอดกี่วัน
ANC_POSTPARTUM_DAYS=42
# Dx หลักที่นับเป็น refer งานแม่และเด็กเสมอ (ขึ้นต้นด้วย)
ANC_REFER_DX_PREFIXES=O,Z32,Z33,Z34,Z35,Z36
# เวลารอคอย = จากคอลัมน์ไหนถึงคอลัมน์ไหนของ service_time (vsttime หรือ service1–20)
ANC_WAIT_FROM_COL=vsttime
ANC_WAIT_TO_COL=service5
ANC_WAIT_MAX_MIN=240

# ---- เป้าหมาย (%) — anemia/lbw ยิ่งต่ำยิ่งดี ----
ANC_TARGET_EARLY12=75
ANC_TARGET_5VISIT=75
ANC_TARGET_DT=90
ANC_TARGET_DENTAL=50
ANC_TARGET_ANEMIA=14
ANC_TARGET_LBW=7

# ---- อื่น ๆ ----
# ไฟล์จับคู่หมู่บ้าน → รพ.สต. (ดาวน์โหลดแม่แบบจากหน้า /check)
ANC_PCU_MAP=pcu_map.csv
# ตั้ง 1 หลังตรวจหน้า /check และทดลองคู่รายงานเดิมแล้ว — ซ่อนแถบเตือน
ANC_DATA_AUDITED=0
ANC_CACHE_SECONDS=600

# ---- หน้าจอ / ความปลอดภัย ----
# ชื่อโรงพยาบาล (ว่าง = อ่านจาก opdconfig ของ HOSxP) / ชื่อภาษาอังกฤษ
ANC_HOSPITAL_NAME=
ANC_HOSPITAL_NAME_EN=
ANC_CONTACT=
ANC_DEV_CONTACT=
# ช่วงวันที่ยาวสุดต่อครั้ง (วัน)
ANC_MAX_DAYS=731
# รัน python app.py ให้ฟังที่ host นี้
ANC_HOST=0.0.0.0
# หน้า /check เปิดเฉพาะ LAN · 1 = เปิดทุกที่ (ไม่แนะนำ)
ANC_CHECK_OPEN=0
# IP/เครือข่ายเพิ่มเติมที่นับเป็น LAN (เช่น IP สาธารณะของ รพ. เมื่อเข้าผ่าน Cloudflare) คั่นด้วย ,
ANC_LAN_NETS=
# reverse proxy ที่เชื่อ X-Forwarded-For
ANC_TRUSTED_PROXIES=127.0.0.1,::1
# ช่วง IP ของ Cloudflare (ว่าง = ค่าที่ฝังในโปรแกรม)
ANC_CF_RANGES=

# ---- ส่งออก JPG/PNG/PDF (ต้องมี Chrome/Edge/Chromium) ----
ANC_EXPORT=1
ANC_EXPORT_WAIT=0
ANC_EXPORT_CACHE_TTL=300
# 1 = ปิด sandbox ของ chromium (container ที่ไม่รองรับ)
ANC_CHROME_NO_SANDBOX=
