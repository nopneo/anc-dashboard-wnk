# ===== ANC Dashboard — คัดลอกเป็น .env แล้วแก้ค่า (ห้าม commit .env) =====
# ---- ฐานข้อมูล HOSxP (ผู้ใช้อ่านอย่างเดียว) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=hos
DB_USER=<readonly_user>
DB_PASS=<password>
PORT=6300
# direct = ต่อ DB ตรง (production) · ssh = ยิงผ่าน `ssh <host> mariadb` (dev ไม่มีรหัส DB)
ANC_DB_MODE=
ANC_SSH_HOST=
ANC_DB_TIMEOUT=60

# ---- รหัสที่แต่ละ รพ. อาจต่างกัน — ตรวจที่หน้า /check ----
# รหัสส่งออกวัคซีน dT หญิงตั้งครรภ์ (person_vaccine.export_vaccine_code / EPI.VACCINETYPE 201–205)
ANC_DT_VACCINE_CODES=201,202,203,204,205
# anc_lab_id ของผล Hct (ว่าง = หาจากชื่อใน anc_lab ที่มีคำว่า hct)
ANC_HCT_LAB_IDS=
# โลหิตจาง: Hct < ค่านี้ (%) ที่อายุครรภ์ >= ANC_HCT_LATE_GA สัปดาห์
ANC_HCT_CUTOFF=33
ANC_HCT_LATE_GA=28
# ติดตามภาวะซีด (ผล Hct หลายครั้งต่อครรภ์): รหัส lab Hct ใน lab_order (ว่าง = เลือกจากชื่อ Hct/Hematocrit)
ANC_HCT_SERIES_LABS=
# เกณฑ์ซีดไตรมาส 2 (GA 14–27) — ว่าง = เท่ากับ ANC_HCT_CUTOFF · Hct เพิ่มกี่จุดถือว่าดีขึ้น (3 ≈ Hb +1 g/dL)
ANC_HCT_CUTOFF_T2=
ANC_HCT_IMPROVE=3
# ทารกน้ำหนักน้อย: < กรัม
ANC_LBW_GRAMS=2500
# infant_dchstts ที่หมายถึงทารกเสียชีวิต/ตายคลอด (ตัดออกจากตัวหาร LBW)
ANC_DEAD_DCHSTTS=08,09
# นับ refer ถึงหลังคลอดกี่วัน
ANC_POSTPARTUM_DAYS=42
# Dx หลักที่นับเป็น refer งานแม่และเด็กเสมอ (ขึ้นต้นด้วย)
ANC_REFER_DX_PREFIXES=O,Z32,Z33,Z34,Z35,Z36
# Dx ที่ไม่จัดอันดับใน Top 10 Refer Diagnoses (Z32 ยังไม่ยืนยันการตั้งครรภ์, Z34 มาฝากครรภ์ — ไม่ใช่ Dx ตอน refer) · ว่าง = จัดอันดับทุกรหัส
ANC_REFER_DX_EXCLUDE=Z32,Z34

# ---- KPI ไอโอดีน / ฝากครรภ์คุณภาพ (เอกสารในโฟลเดอร์ kpi) — ตรวจที่หน้า /check ----
# รหัสยา 24 หลัก (drugitems.did) ของยาเม็ดที่มีไอโอดีน — ค่าเริ่มต้นตามเอกสาร KPI (Triferdine 150, Obimin-az, Iodine GPO, Nataral, Nataral EF, Prenamed, Iolic)
ANC_IODINE_DIDSTD=
# lab_items_code ของ CBC/Hct/Hb และ lab คัดกรองเบาหวาน (GCT/OGTT/FBS/DTX) — ว่าง = เลือกจากชื่อรายการ lab
ANC_CBC_LAB_CODES=
ANC_DM_LAB_CODES=
# หัตถการอัลตราซาวด์ (doctor_operation.icd9) · Dx คัดกรองดาวน์ · Dx คัดกรองเบาหวาน
ANC_US_ICD9=8878,5260700,5260701
ANC_DOWN_DX=Z360,Z362
ANC_DM_DX=Z131
# thalassaemia_result.thalassaemia_result_export ที่นับว่าคัดกรองธาลัสซีเมียแล้ว (PRENATAL.THALASSEMIA)
ANC_THAL_EXPORT_CODES=1,2,4

# ---- โรคติดเชื้อทางเพศสัมพันธ์ (ซิฟิลิส · ไวรัสตับอักเสบบี · HIV) — ตรวจที่หน้า /check ----
# lab_items_code คั่นด้วย , · ว่าง = เลือกจากชื่อรายการ (VDRL/RPR/TPHA · HBs Ag · Anti-HIV/HIV Ag)
ANC_STI_SYPHILIS_LABS=
ANC_STI_HBV_LABS=
ANC_STI_HIV_LABS=
# anc_lab_id ของผลที่ลงในหน้า ANC (person_anc_lab) · ว่าง = เลือกจากรหัสใน anc_lab (VDRL1/2, HIV1/2)
ANC_STI_SYPHILIS_ANC_LABS=
ANC_STI_HBV_ANC_LABS=
ANC_STI_HIV_ANC_LABS=
# ปัสสาวะ Amphetamine / Methamphetamine (ว่าง = เลือกจากชื่อ lab ที่ขึ้นต้นด้วย Methamphetamine / Amphetamine — ได้ทั้งรายการปกติและ "ฟรี")
ANC_STI_AMPH_LABS=
# OGTT ในหญิงตั้งครรภ์: lab_items_code เรียงตามจุดเจาะ (100 g = ก่อนกิน,1 ชม.,2 ชม.,3 ชม. · 75 g = ก่อนกิน,1 ชม.,2 ชม.) · ว่าง = เลือกจากชื่อ
ANC_OGTT_G100_LABS=
ANC_OGTT_G75_LABS=
# เกณฑ์ผิดปกติ mg/dL ต่อจุด (ผิดปกติ = ตั้งแต่ค่านี้ขึ้นไป) · ว่าง = 100 g Carpenter-Coustan 95,180,155,140 · 75 g IADPSG 92,180,153
ANC_OGTT_G100_CUT=
ANC_OGTT_G75_CUT=
# จำนวนค่าที่ผิดปกติขั้นต่ำที่นับว่า "ผิดปกติ" (ค่าเริ่มต้น 2 · IADPSG 75 g วินิจฉัยที่ 1 ค่า ตั้งเป็น 1 ได้)
ANC_OGTT_MIN_ABN=2

# ---- ผลลัพธ์แม่และทารก ----
# ทารกแรกเกิดขาดออกซิเจน = Apgar 1 นาทีต่ำกว่าค่านี้ (หรือบันทึก has_birth_asphyxia) · เป้า ≤ ต่อ 1,000 เกิดมีชีพ
ANC_ASPHYXIA_APGAR=7
ANC_TARGET_ASPHYXIA=25
# infant_delivery_type ที่หมายถึงคลอดก่อนถึง รพ. (BBA)
ANC_BBA_TYPES=3
# Dx ภาวะแทรกซ้อน (รหัส 3–4 หลัก) ระหว่าง LMP ถึงหลังคลอด 42 วัน จาก ovstdiag + iptdiag
ANC_DX_HTN=O10,O11,O13,O14,O15,O16
ANC_DX_GDM=O244
ANC_DX_PPH=O72
ANC_DX_PRETERM=O60

# ---- คัดกรองครรภ์เสี่ยง 27 ข้อ (สมุดสีชมพู) — เกณฑ์ · ดูรายการข้อ/รหัส/คำค้นที่หน้า /check ----
ANC_RISK_AGE_LOW=17
ANC_RISK_AGE_HIGH=35
ANC_RISK_HEIGHT_CM=145
ANC_RISK_BMI_LOW=18.5
ANC_RISK_BMI_HIGH=25
# แก้รหัส Dx / คำค้น HPI-PMH (regex ไม่สนตัวพิมพ์) รายข้อ ชื่อข้อดูใน risk27.py เช่น
# ANC_RISK_DX_TWIN=O30
# ANC_RISK_TEXT_PREV_PRETERM=ก่อนกำหนด|preterm|PTL

# ---- เป้าหมาย (%) — anemia/lbw ยิ่งต่ำยิ่งดี ----
ANC_TARGET_EARLY12=75
ANC_TARGET_5VISIT=75
# ครบ 8 ครั้ง: ว่าง = ตามปีงบ (2566:50 · 2567:55 · 2568:60 · 2569:65 · 2570:70)
ANC_TARGET_VISIT8=
ANC_TARGET_DT=90
ANC_TARGET_DENTAL=50
ANC_TARGET_ANEMIA=14
ANC_TARGET_LBW=7
# ตั้งครรภ์ซ้ำในหญิงอายุ < 20 ปี (ยิ่งต่ำยิ่งดี): ว่าง = ตามปีงบ (2567:13 · 2568:12.5 · 2569:12 · 2570:11.5)
ANC_TARGET_TEEN_REPEAT=
# เอกสาร KPI: หลังคลอด 3 ครั้ง ≥75 · ฝากครรภ์คุณภาพ (HDC) ปีงบ 2570 ≥70 · ไอโอดีน (Workload) ไม่กำหนดเป้า — ว่าง = ไม่ตัดผ่าน/ไม่ผ่าน
ANC_TARGET_POSTNATAL=75
ANC_TARGET_QUALITY=70
ANC_TARGET_IODINE=

# ---- อื่น ๆ ----
# หมู่บ้าน → รพ.สต. รูปแบบเดียวกับ mental_health_dashboard (tmbpart,tambon,moo,village,hospcode,pcu)
# ใช้ไฟล์ village_pcu.csv ชุดเดียวกันได้ · ไม่มีไฟล์ = ไม่แสดงส่วนแยก รพ.สต.
ANC_VILLAGE_CSV=village_pcu.csv
# อำเภอของ รพ. (patient.chwpart / amppart) — ที่อยู่นอกอำเภอนับเป็น "นอกเขตอำเภอ"
ANC_CHWPART=30
ANC_AMPPART=25
# รหัส 5 หลักของ รพ. เอง — หมู่ที่ รพ. ดูแลเองใน village_pcu.csv ใช้รหัสนี้ (แถว "เขต รพ.")
ANC_HOSPCODE=10894
# สัญชาติไทย (person.nationality) — ตัวหาร KPI แบบ "ในเขต" นับเฉพาะหญิงไทย
ANC_THAI_NATIONALITY=99
# บันทึกวันคลอดน้อยกว่านี้ (% ของครรภ์ที่ครบกำหนดแล้ว) → ขึ้นเตือนบนแดชบอร์ด
ANC_LABOR_WARN_PCT=80
# ตั้ง 1 หลังตรวจหน้า /check และทดลองคู่รายงานเดิมแล้ว — ซ่อนแถบเตือน
ANC_DATA_AUDITED=0
ANC_CACHE_SECONDS=600

# ---- หน้าจอ / ความปลอดภัย ----
# ชื่อโรงพยาบาล (ว่าง = อ่านจาก opdconfig ของ HOSxP) / ชื่อภาษาอังกฤษ
ANC_HOSPITAL_NAME=
ANC_HOSPITAL_NAME_EN=
ANC_CONTACT=
ANC_DEV_CONTACT=
# ช่วงวันที่ยาวสุดต่อครั้ง (วัน)
ANC_MAX_DAYS=731
# รัน python app.py ให้ฟังที่ host นี้
ANC_HOST=0.0.0.0
# หน้า /check เปิดเฉพาะ LAN · 1 = เปิดทุกที่ (ไม่แนะนำ)
ANC_CHECK_OPEN=0
# IP/เครือข่ายเพิ่มเติมที่นับเป็น LAN (เช่น IP สาธารณะของ รพ. เมื่อเข้าผ่าน Cloudflare) คั่นด้วย ,
ANC_LAN_NETS=
# reverse proxy ที่เชื่อ X-Forwarded-For
ANC_TRUSTED_PROXIES=127.0.0.1,::1
# ช่วง IP ของ Cloudflare (ว่าง = ค่าที่ฝังในโปรแกรม)
ANC_CF_RANGES=

# ---- หน้ารายชื่อ (กดตัวเลขบนแดชบอร์ดดูรายชื่อ + ส่งออก Excel) — ต้อง login ----
# กุญแจ session: ว่าง = ปิดหน้ารายชื่อทั้งหมด (แดชบอร์ดตัวเลขใช้ได้ตามเดิม)
# สร้างด้วย: python -c "import secrets; print(secrets.token_hex(32))"  · ทุก worker ต้องใช้ค่าเดียวกัน
ANC_SECRET_KEY=
# 1 = เข้าหน้ารายชื่อ/login ได้เฉพาะเครื่องใน รพ. (LAN / ANC_LAN_NETS)
ANC_LIST_LAN_ONLY=0
# 1 = ใช้รหัสกลางตัวเดียว (ไม่มีชื่อผู้ใช้ · audit บันทึกเป็น "passkey" ไม่รู้ว่าใคร) — ตั้งรหัสด้วย python manage.py passkey
#     ควรใช้คู่กับ ANC_LIST_LAN_ONLY=1 · 0 = บัญชีรายคน (adduser)
ANC_LIST_PASSKEY=0
# 1 = ส่ง cookie เฉพาะ HTTPS (เปิดเมื่อใช้ผ่าน https://wnkhos.go.th/anc/)
ANC_COOKIE_SECURE=0
# ที่เก็บบัญชีผู้ใช้และ audit log (SQLite) · ว่าง = ./data
ANC_DATA_DIR=

# ---- ส่งออก JPG/PNG/PDF (ต้องมี Chrome/Edge/Chromium) ----
ANC_EXPORT=1
ANC_EXPORT_WAIT=0
ANC_EXPORT_CACHE_TTL=300
# 1 = ปิด sandbox ของ chromium (container ที่ไม่รองรับ)
ANC_CHROME_NO_SANDBOX=
